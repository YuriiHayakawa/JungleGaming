{
  "name": "junglegaming",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "migrate:up": "bun scripts/migrate.ts up",
    "migrate:down": "bun scripts/migrate.ts down",
    "queue:init": "bun scripts/queue-init.ts",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test --preload ./test/support/db-setup.preload.ts test/integration",
    "test:concurrency": "bun test --preload ./test/support/db-setup.preload.ts test/concurrency",
    "test": "bun run test:unit && bun run test:integration && bun run test:concurrency",
    "test:chaos": "bun test --preload ./test/support/db-setup.preload.ts ./test/concurrency/sigkill-recovery.test.ts ./test/concurrency/crash-before-ack.test.ts ./test/concurrency/concurrent-publishers.test.ts ./test/concurrency/graceful-sigterm.test.ts",
    "test:load": "bun load/load-test.ts",
    "demo": "bun demo/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1156.0",
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "decimal.js": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
