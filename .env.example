# Banco da aplicação (Compose). Dentro dos containers da app, o docker-compose.yml sobrescreve o host para "postgres".
DATABASE_URL=postgresql://junglegaming:junglegaming@localhost:5432/junglegaming
# Banco administrativo usado pelos testes para criar e apagar os bancos por arquivo (research R-17).
TEST_DATABASE_ADMIN_URL=postgresql://junglegaming:junglegaming@localhost:5432/postgres
# Porta publicada pelo postgres do Compose no host.
POSTGRES_PORT=5432
PORT=3001

# Hierarquia de timeouts (I-51, research R-11):
# WALLET_LOCK_TIMEOUT_MS < DB_POOL_ACQUIRE_TIMEOUT_MS
# HTTP_SERVER_TIMEOUT_MS > DB_POOL_ACQUIRE_TIMEOUT_MS + WALLET_LOCK_TIMEOUT_MS + 2000
WALLET_LOCK_TIMEOUT_MS=5000
DB_POOL_MAX=25
DB_POOL_ACQUIRE_TIMEOUT_MS=8000
HTTP_SERVER_TIMEOUT_MS=20000
RETRY_AFTER_SECONDS=1

# Mensageria (feature 002, research R-27). Emulador SQS: MiniStack (I-43); credenciais fictícias.
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
# Papéis por instância (desligados por padrão; o Compose liga por app).
CONSUMER_ENABLED=false
PUBLISHER_ENABLED=false
PENDING_WORKER_ENABLED=false
# Consumidor: visibilidade × 1000 > DB_POOL_ACQUIRE_TIMEOUT_MS + WALLET_LOCK_TIMEOUT_MS + 2000;
# CONSUMER_SHUTDOWN_TIMEOUT_MS + 5000 cabe no stop_grace_period (30 s).
CONSUMER_NAME=wager-transactions-consumer
CONSUMER_WAIT_SECONDS=20
CONSUMER_VISIBILITY_TIMEOUT_SECONDS=30
CONSUMER_RETRY_BASE_SECONDS=5
CONSUMER_RETRY_MAX_SECONDS=60
CONSUMER_SHUTDOWN_TIMEOUT_MS=10000
# Publicador da outbox (I-31, I-65).
PUBLISHER_BATCH_SIZE=10
PUBLISHER_LEASE_MS=30000
PUBLISHER_POLL_MS=1000
PUBLISHER_BACKOFF_MIN_MS=1000
PUBLISHER_BACKOFF_MAX_MS=60000
# Worker de PENDING_REFERENCE (I-21, I-64).
PENDING_WORKER_BATCH_SIZE=10
PENDING_WORKER_LEASE_MS=30000
PENDING_WORKER_POLL_MS=1000
PENDING_MAX_ATTEMPTS=10
PENDING_TTL_MS=600000
PENDING_BACKOFF_BASE_MS=5000
PENDING_BACKOFF_MAX_MS=60000
PENDING_JITTER_RATIO=0.2

# Failpoints de teste (I-40); ignorados quando NODE_ENV=production.
FAILPOINT=
NODE_ENV=development
